# Break-glass service configuration. Copy to server/break-glass/.env and fill in
# the same values already used by the n8n workflow (this service reads them
# directly instead of n8n's credential store). Never commit the real .env.

# Port the service listens on (behind the reverse proxy).
PORT=8080

# Shared secret for CI -> service auth (X-Break-Glass-Token header). Same value
# as the GitHub secret BREAK_GLASS_SHARED_SECRET.
BREAK_GLASS_SHARED_SECRET=

# Slack app credentials.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=

# Comma-separated Slack member IDs allowed to approve/deny (flat list).
SLACK_APPROVER_IDS=

# Fine-grained GitHub PAT with pull-request/issue comment write on the repo.
GITHUB_TOKEN=
