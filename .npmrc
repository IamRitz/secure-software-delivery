# Supply-chain protection: refuse to install any dependency version published
# less than 7 days ago, so a freshly-published (possibly compromised) release
# cannot be pulled into a build during its most dangerous window. The value is a
# number of DAYS (npm >= 11.10; the "7 days" string form never shipped).
#
# Enforced at every install point (local, GitHub Actions, Jenkins, Dockerfile),
# which each upgrade npm to a pinned >= 11.10 version first — npm 10.x silently
# ignores this key, so older toolchains degrade gracefully rather than breaking.
#
# This is the install-time twin of the Dependabot `cooldown` in
# .github/dependabot.yml (which delays *PR creation* by the same 7 days): the
# cooldown keeps too-fresh versions out of proposed lockfile updates, and
# min-release-age refuses to install one even if it reached the lockfile another
# way. Two mechanisms, one 7-day principle.
min-release-age=7
